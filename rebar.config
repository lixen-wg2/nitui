{erl_opts, [debug_info]}.
{deps, [
]}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {source_url, <<"https://github.com/lixen-wg2/nitui">>},
    {homepage_url, <<"https://github.com/lixen-wg2/nitui">>},
    {main, <<"overview">>},
    %% rebar3_ex_doc only merges the mermaid loader into an existing
    %% before_closing_body_tag entry, so declare an empty one here.
    {before_closing_body_tag, #{html => "", epub => ""}},
    {with_mermaid, true},
    {assets, #{<<"guides/assets">> => <<"assets">>}},
    {extras, [
        <<"guides/overview.md">>,
        <<"guides/quick-start.md">>,
        <<"guides/first-app.md">>,
        <<"guides/elements.md">>,
        <<"guides/layout.md">>,
        <<"guides/focus-and-navigation.md">>,
        <<"guides/events.md">>,
        <<"guides/views-and-overlays.md">>,
        <<"guides/tables.md">>,
        <<"guides/text-and-clipboard.md">>,
        <<"guides/live-updates.md">>,
        <<"guides/styling.md">>,
        <<"guides/key-bindings.md">>,
        <<"guides/configuration.md">>,
        <<"guides/terminal-lifecycle.md">>,
        <<"guides/architecture.md">>,
        <<"guides/demo.md">>,
        <<"LICENSE.md">>
    ]},
    {groups_for_extras, [
        {<<"Getting started">>, [<<"guides/overview.md">>,
                                 <<"guides/quick-start.md">>,
                                 <<"guides/first-app.md">>]},
        {<<"Guides">>, [<<"guides/elements.md">>,
                        <<"guides/layout.md">>,
                        <<"guides/focus-and-navigation.md">>,
                        <<"guides/events.md">>,
                        <<"guides/views-and-overlays.md">>,
                        <<"guides/tables.md">>,
                        <<"guides/text-and-clipboard.md">>,
                        <<"guides/live-updates.md">>,
                        <<"guides/styling.md">>]},
        {<<"Reference">>, [<<"guides/key-bindings.md">>,
                           <<"guides/configuration.md">>,
                           <<"guides/terminal-lifecycle.md">>,
                           <<"guides/architecture.md">>,
                           <<"guides/demo.md">>]}
    ]},
    {groups_for_modules, [
        {<<"API">>, [nitui, nit_callback, nit_element]},
        {<<"Helpers">>, [nit_format, nit_shortcuts, nit_unicode, nit_clipboard]},
        {<<"Runtime">>, [nit_server, nit_engine, nit_focus, nit_nav, nit_tree_nav,
                         nit_hit, nit_layout, nit_bounds, nit_tree]},
        {<<"Rendering">>, [nit_render, nit_screen, nit_ansi, nit_terminal]},
        {<<"Terminal">>, [nit_tty, nit_input, nit_sighandler]},
        {<<"Elements">>, [nit_el_box, nit_el_button, nit_el_hbox, nit_el_header,
                          nit_el_input, nit_el_list, nit_el_modal, nit_el_panel,
                          nit_el_progress_bar, nit_el_scroll, nit_el_spacer,
                          nit_el_sparkline, nit_el_stat_row, nit_el_status_bar,
                          nit_el_table, nit_el_tabs, nit_el_text,
                          nit_el_text_view, nit_el_tree, nit_el_vbox]},
        {<<"Application">>, [nitui_app, nit_sup]}
    ]}
]}.